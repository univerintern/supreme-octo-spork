{
  "name": "universe-3d-explorer",
  "version": "1.0.0",
  "description": "Interactive 3D Solar System and Universe exploration with live planetary orbits and celestial bodies.",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "lint": "echo 'No lint errors'",
    "preview": "vite preview",
    "check:types": "tsc --noEmit",
    "db:create": "wrangler d1 create universespacecosmicbion_appointments",
    "db:init": "wrangler d1 execute universespacecosmicbion_appointments --file=./schema.sql",
    "dev:worker": "wrangler dev --test-scheduled",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@biconomy/account": "^4.5.7",
    "@covalenthq/client-sdk": "^3.0.9",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@lifi/sdk": "^4.12.0",
    "@lifi/wallet-management": "^4.3.5",
    "@lifi/widget": "^4.10.3",
    "@mui/material": "^9.5.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@reown/appkit": "^1.8.24",
    "@reown/appkit-adapter-wagmi": "^1.8.24",
    "@solana/wallet-adapter-react": "^0.15.40",
    "@solana/wallet-adapter-react-ui": "^0.9.40",
    "@solana/wallet-adapter-wallets": "^0.19.40",
    "@solana/web3.js": "^1.95.8",
    "@supabase/supabase-js": "^2.117.3",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.105.3",
    "@tronweb3/tronwallet-adapter-react-hooks": "^1.1.14",
    "@tronweb3/tronwallet-adapter-react-ui": "^1.2.2",
    "@tronweb3/tronwallet-adapter-tronlink": "^1.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.4",
    "ethers": "^6.17.0",
    "express": "^5.3.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.55.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.14",
    "three": "^0.186.1",
    "tronweb": "^6.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "viem": "^2.57.15",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^2.0.0",
    "wagmi": "^3.7.11"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.14.0",
    "@types/qrcode.react": "^3.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "wrangler": "^4.151.0"
  }
}
